# Copy to .env.local and fill in the values. Never commit .env.local.
# Values come from the existing hackathon Supabase project
# (Dashboard > Project Settings > API Keys). Do not create a new project.

# Public Supabase settings. These are inlined into the browser bundle;
# access to data is limited by Row Level Security.
# Use the publishable key (sb_publishable_...) or the legacy anon key.
# Never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets are not needed yet. When one is added, it must never
# use the NEXT_PUBLIC_ prefix.
